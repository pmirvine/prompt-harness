# PromptHarness - sample environment file
#
# PromptHarness stores only the NAME of the environment variable that holds a
# provider's API key, and reads the key from the environment each time it makes
# a request. It does NOT read .env files itself, so load this file into your
# shell before launching:
#
#   cp .env.sample .env          # .env is git-ignored; never commit real keys
#   $EDITOR .env                 # replace the placeholders you need
#   set -a; source .env; set +a  # export everything in .env into this shell
#   promptharness
#
# The *_BASE_URL values are not read by PromptHarness either. They are here so
# you can register a provider from the same file, for example:
#
#   promptharness provider add openai --base-url "$OPENAI_BASE_URL" --api-key-env OPENAI_API_KEY
#
# Every endpoint below must speak the OpenAI chat completions format
# (POST {base_url}/chat/completions). Some are compatibility layers with
# limitations; check each provider's documentation. Only fill in the providers
# you actually use. Models are referred to as provider:model, for example
# openai:gpt-4o-mini.

# --- OpenAI ------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key

# --- Anthropic (OpenAI SDK compatibility endpoint) ---------------------------
# Anthropic describes this layer as intended for testing and comparison; some
# OpenAI parameters are ignored. See platform.claude.com/docs (OpenAI SDK compatibility).
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# --- Google Gemini (OpenAI compatibility endpoint) ---------------------------
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-gemini-key

# --- Amazon Bedrock (OpenAI-compatible Chat Completions) ---------------------
# Replace us-east-1 with your region. Authenticate with an Amazon Bedrock API
# key (created in the AWS console), which the OpenAI client sends as the key.
# Model ids are Bedrock model ids, and only models that support the Chat
# Completions API work here.
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# --- OpenRouter ----------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# --- Groq ----------------------------------------------------------------------
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_your-groq-key

# --- Together AI -----------------------------------------------------------------
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_API_KEY=your-together-key

# --- Mistral -----------------------------------------------------------------------
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=your-mistral-key

# --- xAI -----------------------------------------------------------------------------
XAI_BASE_URL=https://api.x.ai/v1
XAI_API_KEY=xai-your-xai-key

# --- DeepSeek ----------------------------------------------------------------------------
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- Local servers (no API key needed) ---------------------------------------
# Leave the key env var empty when you register these: omit --api-key-env and
# PromptHarness sends a placeholder key. Change host/port if the server runs
# on another machine, for example http://192.168.1.50:1234/v1.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1
LLAMACPP_BASE_URL=http://localhost:8080/v1
